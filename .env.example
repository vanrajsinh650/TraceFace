# Required: Ethereum Sepolia blockchain (Chain ID: 11155111)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=your_wallet_private_key_here_without_0x_prefix
CONTRACT_ADDRESS=your_deployed_EvidenceStorage_contract_address

# Optional: PimEyes credentials (alternative to cookies file)
# If not set, PimEyes will try pimeyes_cookies.json
PIMEYES_EMAIL=your_pimeyes_email
PIMEYES_PASSWORD=your_pimeyes_password

# Optional: Similarity threshold override (default: 0.35)
# SIMILARITY_THRESHOLD=0.35

# Optional: InsightFace config
# INSIGHTFACE_MODEL=buffalo_l
# INSIGHTFACE_DET_THRESH=0.5
# INSIGHTFACE_GPU=0
